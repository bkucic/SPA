<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/unos_generic.css">
</head>

<body>
    <%- include("partials/header_admin") %>
        <div class="page-container">
            <h1>Izmjena servisa</h1>

            <form action="/automobili/<%= vozilo.sifra %>/servis/<%= servis.sifra %>" method="POST" class="main_form">

                <div>
                    <label for="tip_sifra">Tip servisa:</label>
                    <select name="tip_sifra" required>
                        <% tipovi_servisa.forEach(function(tip) { %>
                            <option value="<%= tip.sifra %>" <%=tip.sifra===servis.tip_servisa_sifra ? 'selected' : ''
                                %>>
                                <%= tip.naziv %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <% const d=new Date(servis.datum); const localDate=d.getFullYear() + '-' + String(d.getMonth() +
                    1).padStart(2, '0' ) + '-' + String(d.getDate()).padStart(2, '0' ); 
                    const today=new Date( Date.now() - new Date().getTimezoneOffset() * 60000 ) .toISOString() .split("T")[0] %>
                    <div>
                        <label for="datum">Datum servisa:</label>
                        <input type="date" id="datum" name="datum" value="<%= localDate  %>" max="<%= today  %>">
                    </div>

                    <button type="submit" class="submitBtn">Spremi promjene</button>
            </form>
        </div>
</body>

</html>