<!DOCTYPE html>
<html>

<head>
  <link rel="stylesheet" href="/styles/base.css">
  <link rel="stylesheet" href="/styles/modal.css">
  <link rel="stylesheet" href="/styles/automobili.css">

  <script src="/scripts/comparison.js" defer></script>
  <script src="/scripts/sliders.js" defer></script>
  <script src="/scripts/toggleSection.js" defer></script>
  <script src="/scripts/servisiPopup.js" defer></script>

</head>

<body>

  <%- include("partials/header_kupac") %>
    <!-- FILTERI -->
    <form method="GET" action="/automobili" class="main_form">

      <div class="filter-title">
        <h3>Filteri za vozilo</h3>
        <button type="button" class="toggle-btn" onclick="toggleSection('voziloFilters', 'toggle-btn-vozilo')"
          id="toggle-btn-vozilo"> + </button>
      </div>

      <!-- za auto -->
      <div id="voziloFilters" class="section-content" style="display: none;">

        <div class="top-filters">
          <input type="text" name="search" placeholder="Pretraži naziv vozila" value="<%= filters.search || '' %>">
        </div>

        <div class="filter-box">
          <h4>Boje</h4>

          <% boje.forEach(function(b) { %>
            <label class="checkbox-item">
              <input type="checkbox" name="boja" value="<%= b.boja %>" <%=Array.isArray(filters.boja) ?
                filters.boja.includes(b.boja) ? 'checked' : '' : filters.boja===b.boja ? 'checked' : '' %> >
              <span>
                <%= b.boja %>
              </span>
            </label>
            <% }) %>

        </div>

        <div class="filter-box">
          <h4>Oblik</h4>

          <% oblici.forEach(function(b) { %>
            <label class="checkbox-item">
              <input type="checkbox" name="oblik" value="<%= b.oblik %>" <%=Array.isArray(filters.oblik) ?
                filters.oblik.includes(b.oblik) ? 'checked' : '' : filters.oblik===b.oblik ? 'checked' : '' %> >
              <span>
                <%= b.oblik %>
              </span>
            </label>
            <% }) %>

        </div>

      </div>

      <div class="filter-title">
        <h3>Filteri za motor</h3>
        <button type="button" class="toggle-btn" id="toggle-btn-motor"
          onclick="toggleSection('motorFilters', 'toggle-btn-motor')"> + </button>
      </div>

      <!-- za motore -->
      <div id="motorFilters" class="section-content" style="display: none;">

        <div class="top-filters">
          <input type="text" name="search_engine" placeholder="Pretraži naziv motora"
            value="<%= filters.search_engine || '' %>">
        </div>

        <div class="filter-box">
          <h4>Konfiguracija</h4>

          <% konfiguracije.forEach(function(b) { %>
            <label class="checkbox-item">
              <input type="checkbox" name="konfiguracija" value="<%= b.konfiguracija %>"
                <%=Array.isArray(filters.konfiguracija) ? filters.konfiguracija.includes(b.konfiguracija) ? 'checked'
                : '' : filters.konfiguracija===b.konfiguracija ? 'checked' : '' %> >
              <span>
                <%= b.konfiguracija %>
              </span>
            </label>
            <% }) %>

        </div>

        <div class="range-group">
          <label>Volumen motora</label>

          <div class="range-inputs">
            <input type="number" class="min-input" name="minVolumen" placeholder="<%= volumeni.min %>"
              value="<%= filters.minVolumen || '' %>">

            <input type="number" class="max-input" name="maxVolumen" placeholder="<%= volumeni.max %>"
              value="<%= filters.maxVolumen || '' %>">
          </div>

          <div class="slider-wrapper">
            <input type="range" class="min-slider" min="<%= volumeni.min %>" max="<%= volumeni.max %>"
              value="<%= filters.minVolumen || volumeni.min %>">

            <input type="range" class="max-slider" min="<%= volumeni.min %>" max="<%= volumeni.max %>"
              value="<%= filters.maxVolumen || volumeni.max %>">
          </div>
        </div>

        <div class="range-group">
          <label>Broj cilindara</label>

          <div class="range-inputs">
            <input type="number" class="min-input" name="minCilindar" placeholder="<%= cilindri.min %>"
              value="<%= filters.minCilindar || '' %>">

            <input type="number" class="max-input" name="maxCilindar" placeholder="<%= cilindri.max %>"
              value="<%= filters.maxCilindar || '' %>">
          </div>

          <div class="slider-wrapper">
            <input type="range" class="min-slider" min="<%= cilindri.min %>" max="<%= cilindri.max %>"
              value="<%= filters.minCilindar || cilindri.min %>">

            <input type="range" class="max-slider" min="<%= cilindri.min %>" max="<%= cilindri.max %>"
              value="<%= filters.maxCilindar || cilindri.max %>">
          </div>
        </div>

      </div>

      <div class="filter-title">
        <h3>Filteri za gume</h3>
        <button type="button" class="toggle-btn" onclick="toggleSection('gumaFilters', 'toggle-btn-guma')"
          id="toggle-btn-guma">
          +
        </button>
      </div>

      <!-- za gume -->
      <div id="gumaFilters" class="section-content" style="display: none;">

        <div class="top-filters">
          <input type="text" name="search_tire" placeholder="Pretraži naziv gume" value="<%= filters.search_tire || '' %>">
        </div>

        <div class="filter-box">
          <h4>Struktura</h4>

          <% strukture.forEach(function(b) { %>
            <label class="checkbox-item">
              <input type="checkbox" name="struktura" value="<%= b.struktura %>" <%=Array.isArray(filters.struktura) ?
                filters.struktura.includes(b.struktura) ? 'checked' : '' : filters.struktura===b.struktura ? 'checked'
                : '' %> >
              <span>
                <%= b.struktura %>
              </span>
            </label>
            <% }) %>

        </div>

        <div class="range-group">
          <label>Širina</label>

          <div class="range-inputs">
            <input type="number" class="min-input" name="minSirina" placeholder="<%= sirine.min %>"
              value="<%= filters.minSirina || '' %>">

            <input type="number" class="max-input" name="maxSirina" placeholder="<%= sirine.max %>"
              value="<%= filters.maxSirina || '' %>">
          </div>

          <div class="slider-wrapper">
            <input type="range" class="min-slider" min="<%= sirine.min %>" max="<%= sirine.max %>"
              value="<%= filters.minSirina || sirine.min %>">

            <input type="range" class="max-slider" min="<%= sirine.min %>" max="<%= sirine.max %>"
              value="<%= filters.maxSirina || sirine.max %>">
          </div>
        </div>

        <div class="range-group">
          <label>Omjer visine i širine</label>

          <div class="range-inputs">
            <input type="number" class="min-input" name="minOmjer" placeholder="<%= omjeri.min %>"
              value="<%= filters.minOmjer || '' %>" step="0.01">

            <input type="number" class="max-input" name="maxOmjer" placeholder="<%= omjeri.max %>"
              value="<%= filters.maxOmjer || '' %>" step="0.01">
          </div>

          <div class="slider-wrapper">
            <input type="range" class="min-slider" min="<%= omjeri.min %>" max="<%= omjeri.max %>"
              value="<%= filters.minOmjer || omjeri.min %>" step="0.01">

            <input type="range" class="max-slider" min="<%= omjeri.min %>" max="<%= omjeri.max %>"
              value="<%= filters.maxOmjer || omjeri.max %>" step="0.01">
          </div>
        </div>

        <div class="range-group">
          <label>Veličina kotača</label>

          <div class="range-inputs">
            <input type="number" class="min-input" name="minVelicina" placeholder="<%= velicine.min %>"
              min="<%= velicine.min %>" max="<%= velicine.max %>" value="<%= filters.minVelicina || '' %>">

            <input type="number" class="max-input" name="maxVelicina" placeholder="<%= velicine.max %>"
              min="<%= velicine.min %>" max="<%= velicine.max %>" value="<%= filters.maxVelicina || '' %>">
          </div>

          <div class="slider-wrapper">
            <input type="range" class="min-slider" min="<%= velicine.min %>" max="<%= velicine.max %>"
              value="<%= filters.minVelicina || velicine.min %>">

            <input type="range" class="max-slider" min="<%= velicine.min %>" max="<%= velicine.max %>"
              value="<%= filters.maxVelicina || velicine.max %>">
          </div>
        </div>

      </div>

      <div class="filter-buttons">

        <button type="submit">
          Filtriraj
        </button>

        <a href="/automobili" class="reset-button">
          Ukloni filtere
        </a>

      </div>

    </form>
    <!-- AUTI -->
    <div class="cars-container">

      <% vozila.forEach(function(vozilo) { %>

        <div class="car-card">

          <div class="car-header">

            <h2>
              <%= vozilo.naziv %>
            </h2>

            <button type="button" class="service-button" onclick="openServiceModal('<%= vozilo.sifra %>')">
              Servisi
            </button>

          </div>

          <div class="car-info">

            <div class="info-section">
              <h3>Marka: <%= vozilo.marka_naziv %>
              </h3>
            </div>

            <div class="info-section">
              <h3>Osnovne informacije</h3>

              <p><strong>Boja:</strong>
                <%= vozilo.boja %>
              </p>
              <p><strong>Oblik:</strong>
                <%= vozilo.oblik %>
              </p>
            </div>

            <div class="info-section">
              <h3>Motor</h3>

              <p><strong>Naziv:</strong>
                <%= vozilo.motor_naziv %>
              </p>
              <p><strong>Volumen:</strong>
                <%= vozilo.volumen %>
              </p>
              <p><strong>Broj cilindara:</strong>
                <%= vozilo.broj_cilindara %>
              </p>
              <p><strong>Konfiguracija:</strong>
                <%= vozilo.konfiguracija %>
              </p>
            </div>

            <div class="info-section">
              <h3>Gume</h3>

              <p><strong>Naziv:</strong>
                <%= vozilo.guma_naziv %>
              </p>
              <p><strong>Širina:</strong>
                <%= vozilo.sirina %>
              </p>
              <p><strong>Omjer visine i širine:</strong>
                <%= vozilo.omjer_visine_i_sirine %>
              </p>
              <p><strong>Struktura:</strong>
                <%= vozilo.struktura %>
              </p>
              <p><strong>Veličina kotača:</strong>
                <%= vozilo.velicina_kotaca %>
              </p>
            </div>

          </div>

          <button class="compare-button" id="compare-btn-<%= vozilo.sifra %>"
            onclick="toggleCompare('<%= vozilo.sifra %>')">
            Dodaj za usporedbu
          </button>

          <% if (vozilo.rezervirano) { %>

            <button class="reserved-button" disabled>
              Rezervirano
            </button>

            <% } else { %>

              <a class="reserve-button" href="/automobili/<%= vozilo.sifra %>/rezerviraj">
                Rezerviraj
              </a>

              <% } %>

                <!-- servisi -->
                <div id="services-<%= vozilo.sifra %>" style="display: none;">
                  <h2>Servisi vozila: <%= vozilo.naziv %>
                  </h2>

                  <% const servisiVozilo=[]; for (let i=0; i < servisi.length; i++) { if
                    (servisi[i].vozilo_sifra==vozilo.sifra) { servisiVozilo.push(servisi[i]); } } %>

                    <% if (servisiVozilo && servisiVozilo.length> 0) { %>

                      <ul>
                        <% servisiVozilo.forEach(function(servis) { %>
                          <li>
                            <strong>
                              <%= servis.naziv %>
                            </strong>
                            - <%= new Date(servis.datum).toLocaleDateString("hr-HR") %>
                          </li>
                          <% }) %>
                      </ul>

                      <% } else { %>

                        <p>Nema servisa.</p>

                        <% } %>

                </div>

        </div>

        <% }) %>

    </div>

    <!-- modal za servise -->
    <div id="serviceModal" class="modal" style="display: none;">

      <div class="modal-content">

        <span class="close-modal" onclick="closeServiceModal()">
          &times;
        </span>

        <div id="serviceList"></div>

      </div>

    </div>

</body>

</html>