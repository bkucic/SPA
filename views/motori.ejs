<!DOCTYPE html>
<html>

<head>
  <link rel="stylesheet" href="/styles/base.css">
  <link rel="stylesheet" href="/styles/prikaz_generic.css">
  <link rel="stylesheet" href="/styles/modal.css">
  <script src="/scripts/servisiPopup.js" defer></script>
</head>

<body>

  <%- include("partials/header_admin") %>

    <div class="addBtn">
      <a href="/motori/unos">Dodaj motor</a>
    </div>

    <table>
      <thead>
        <tr>
          <th>Šifra</th>
          <th>Naziv</th>
          <th>Volumen</th>
          <th>Broj cilindara</th>
          <th>Konfiguracija</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% motori.forEach(function(motor) { %>
          <tr>
            <td>
              <%= motor.sifra %>
            </td>
            <td>
              <%= motor.naziv %>
            </td>
            <td>
              <%= motor.volumen %>
            </td>
            <td>
              <%= motor.broj_cilindara %>
            </td>
            <td>
              <%= motor.konfiguracija %>
            </td>
            <td>
              <form action="/motori/<%= motor.sifra %>/remove" method="POST">
                <button type="submit">Izbriši</button>
              </form>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>

    <%- include("partials/result_popup") %>
</body>

</html>